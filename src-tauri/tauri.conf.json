{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOCH Calculator",
  "version": "0.1.0",
  "identifier": "io.github.jjpacve.sochcalculator",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Калькулятор баллов",
        "width": 760,
        "height": 680,
        "minWidth": 420,
        "minHeight": 540,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
